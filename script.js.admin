// Ambil nilai dari input form
const nipInput = document.getElementById('loginNip').value;
const passwordInput = document.getElementById('loginPassword').value;

// Tentukan NIP khusus yang menjadi Admin
const adminNip = '199408312025061003';

if (nipInput === adminNip) {
    // Logika jika NIP tersebut yang login
    // Pastikan juga mengecek password adminnya
    if (passwordInput === 'passwordAdminAnda') {
        alert('Selamat datang, Admin!');
        // Arahkan ke halaman dashboard admin
        // window.location.href = 'dashboard-admin.html';
    } else {
        // Tampilkan error password salah
        document.getElementById('loginError').classList.remove('hidden');
    }
} else {
    // Logika untuk user/pengguna biasa (NIP selain 199408312025061003)
    // Cek NIP dan password user di sini...
    alert('Selamat datang, Pengguna!');
    // window.location.href = 'dashboard-user.html';
}
